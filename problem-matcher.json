{
  "problemMatcher": [
    {
      "owner": "uncomment-lint",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+)\\s+(error|warning)\\s+\\[[^\\]]+\\]\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "uncomment-check",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
